# _Ykan MCP configuration
# Place the REAL .env ABOVE your web root (not web-accessible) and point
# MCP_ENV_FILE in mcp.php at its absolute path. Never commit the real .env.

# The shared secret that gates the MCP endpoint (also the ?k= in the URL).
MCP_SECRET=change-me-to-a-long-random-string

# Absolute path to the folder that CONTAINS your project folders (web root).
MCP_ROOT=/homez.NNN/youruser/www
